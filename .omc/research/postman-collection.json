      {
        "key": "baseUrl",
        "value": "http://localhost:3100",
        "type": "string"
      },
      {
        "key": "accessToken",
        "value": "",
        "type": "string"
      },
      {
        "key": "refreshToken",
        "value": "",
        "type": "string"
      },

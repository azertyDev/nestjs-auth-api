      },
      {
        "key": "autoRefreshPrevAccess",
        "value": "",
        "type": "string"
      },
      {
        "key": "email",
        "value": "alice@example.com",
        "type": "string"
      },
      {
        "key": "password",
        "value": "StrongP@ss1",
        "type": "string"
      }

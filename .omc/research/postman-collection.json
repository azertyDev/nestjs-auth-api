                  "type": "text/javascript",
                  "exec": [
                    "pm.test('200 OK after auto-refresh',()=>pm.response.to.have.status(200));",
                    "pm.test('auto-refresh actually fired',()=>pm.expect(pm.collectionVariables.get('autoRefreshFired')).to.eql('1'));",
                    "pm.test('access token rotated',()=>{",
                    "  const prev = pm.collectionVariables.get('autoRefreshPrevAccess');",
                    "  const cur  = pm.collectionVariables.get('accessToken');",
                    "  pm.expect(cur).to.not.eql(prev);",
                    "  pm.expect(cur).to.not.equal('');",
                    "});",
                    "const j = pm.response.json();",
                    "pm.test('email matches',()=>pm.expect(j.email).to.eql(pm.variables.get('email')));"
                  ]

            "name": "List users (admin) - 200 with pagination",
            "event": [
              {
                "listen": "prerequest",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "if (!pm.collectionVariables.get('adminAccessToken')) {",
                    "  console.warn('[skip] requires adminAccessToken — promote a user to ADMIN and set collection var first');",
                    "  pm.execution.skipRequest();",
                    "}"
                  ]
                }
              },
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('200 OK',()=>pm.response.to.have.status(200));",
                    "const j = pm.response.json();",
                    "pm.test('paginated shape',()=>{",
                    "  pm.expect(j).to.have.property('data').that.is.an('array');",
                    "  pm.expect(j).to.have.property('total').that.is.a('number');",
                    "  pm.expect(j).to.have.property('page').that.eql(1);",
                    "  pm.expect(j).to.have.property('limit').that.eql(5);",
                    "  pm.expect(j).to.have.property('totalPages').that.is.a('number');",
                    "});",
                    "pm.test('items are PublicUser (no passwordHash)',()=>{",
                    "  for (const u of j.data) {",
                    "    pm.expect(u).to.have.property('id');",
                    "    pm.expect(u).to.have.property('email');",
                    "    pm.expect(u).to.have.property('role');",
                    "    pm.expect(u).to.not.have.property('passwordHash');",
                    "  }",
                    "});",
                    "pm.test('size respects limit',()=>pm.expect(j.data.length).to.be.at.most(5));"
                  ]
                }
              }

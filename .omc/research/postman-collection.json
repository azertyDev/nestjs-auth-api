{
  "collection": {
    "info": {
      "name": "NestJS Auth API",
      "description": "Full flow + collection-level auto-refresh + verification",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "event": [
      {
        "listen": "prerequest",
        "script": {
          "type": "text/javascript",
          "exec": [
            "// Collection-level auto-refresh: if access expires in <30s, rotate via /auth/refresh",
            "const access = pm.collectionVariables.get('accessToken');",
            "const refresh = pm.collectionVariables.get('refreshToken');",
            "if (!access || !refresh) return;",
            "const url = pm.request.url.toString();",
            "if (url.includes('/auth/refresh') || url.includes('/auth/register') || url.includes('/auth/login')) return;",
            "let exp;",
            "try {",
            "  const part = access.split('.')[1].replace(/-/g,'+').replace(/_/g,'/');",
            "  const pad = part + '='.repeat((4 - part.length % 4) % 4);",
            "  exp = JSON.parse(Buffer.from(pad,'base64').toString('utf8')).exp;",
            "} catch (e) { return; }",
            "const now = Math.floor(Date.now()/1000);",
            "if (exp - now > 30) return;",
            "console.log('access expiring in', exp - now, 's — auto-refresh');",
            "const beforeAccess = access;",
            "pm.sendRequest({",
            "  url: pm.variables.get('baseUrl') + '/auth/refresh',",
            "  method: 'POST',",
            "  header: { 'Content-Type': 'application/json' },",
            "  body: { mode: 'raw', raw: JSON.stringify({ refreshToken: refresh }) },",
            "}, (err, res) => {",
            "  if (err || res.code !== 200) { console.warn('auto-refresh failed', err || res.code); return; }",
            "  const j = res.json();",
            "  pm.collectionVariables.set('oldRefreshToken', refresh);",
            "  pm.collectionVariables.set('accessToken', j.accessToken);",
            "  pm.collectionVariables.set('refreshToken', j.refreshToken);",
            "  pm.collectionVariables.set('autoRefreshFired', '1');",
            "  pm.collectionVariables.set('autoRefreshPrevAccess', beforeAccess);",
            "  console.log('auto-refresh ok, new access set');",
            "});"
          ]
        }
      }
    ],

          {
            "name": "Force-expire access (setup)",
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('health ok (setup)',()=>pm.response.to.have.status(200));",
                    "// force-expire current access token by tampering its payload exp claim",
                    "const a = pm.collectionVariables.get('accessToken');",
                    "const [h,p,s] = a.split('.');",
                    "const pad = p.replace(/-/g,'+').replace(/_/g,'/');",
                    "const padded = pad + '='.repeat((4 - pad.length % 4) % 4);",
                    "const payload = JSON.parse(Buffer.from(padded,'base64').toString('utf8'));",
                    "payload.exp = Math.floor(Date.now()/1000) - 60;",
                    "const newP = Buffer.from(JSON.stringify(payload)).toString('base64').replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');",
                    "pm.collectionVariables.set('autoRefreshFired','');",
                    "pm.collectionVariables.set('autoRefreshPrevAccess','');",
                    "pm.collectionVariables.set('accessToken', h+'.'+newP+'.'+s);",
                    "console.log('access exp forced to past, next request must auto-refresh');"
                  ]
                }
              }
            ],
            "request": {
              "method": "GET",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "url": {
                "raw": "{{baseUrl}}/health",
                "host": [
                  "{{baseUrl}}"
                ],
                "path": [
                  "health"
                ]
              }

          {
            "name": "Register",
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.test(\"201\",()=>pm.response.to.have.status(201));",
                    "const j = pm.response.json();",
                    "if (j.accessToken) {",
                    "  pm.collectionVariables.set('accessToken', j.accessToken);",
                    "  try {",
                    "    const p = j.accessToken.split('.')[1].replace(/-/g,'+').replace(/_/g,'/');",
                    "    const pad = p + '='.repeat((4 - p.length % 4) % 4);",
                    "    const payload = JSON.parse(Buffer.from(pad,'base64').toString('utf8'));",
                    "    if (payload.sub) pm.collectionVariables.set('userId', payload.sub);",
                    "  } catch (e) {}",
                    "}",
                    "if (j.refreshToken) {",
                    "  pm.collectionVariables.set('oldRefreshToken', pm.collectionVariables.get('refreshToken') || '');",
                    "  pm.collectionVariables.set('refreshToken', j.refreshToken);",
                    "}",
                    "pm.test(\"userId is uuid\",()=>pm.expect(pm.collectionVariables.get(\"userId\")).to.match(/^[0-9a-f-]{36}$/));"
                  ]
                }
              }
            ],
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
                "options": {
                  "raw": {
                    "language": "json"
                  }
                }
              },
              "url": {
                "raw": "{{baseUrl}}/auth/register",
                "host": [
                  "{{baseUrl}}"
                ],
                "path": [
                  "auth",
                  "register"
                ]
              }
            },
            "response": []
          },

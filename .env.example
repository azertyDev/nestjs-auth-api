# Server
NODE_ENV=development
PORT=3100

# Database
DATABASE_URL=postgresql://authapi:authapi@localhost:5433/auth_db?schema=public

# JWT — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=replace-with-64-byte-random-secret
JWT_REFRESH_SECRET=replace-with-different-64-byte-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=auth-api
JWT_AUDIENCE=auth-api-clients

# Proxy / clock tolerance
TRUST_PROXY_HOPS=1
JWT_CLOCK_TOLERANCE_SEC=30

# Host port mapping (compose)
API_HOST_PORT=3100
DB_HOST_PORT=5433

# Throttling (global default)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3100

# Swagger
ENABLE_SWAGGER=true

# Logging
LOG_LEVEL=info

# Admin seed (optional — seed runs on boot if both set)
ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=ChangeMe-StrongP@ss1
